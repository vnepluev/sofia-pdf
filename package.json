{
  "name": "sofia-pdf",
  "version": "1.0.0",
  "description": "Sofia PDF-generator",
  "author": "Valeriy V Nepluev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:push": "bun drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "bun drizzle-kit generate --config=drizzle.config.ts",
    "db:studio": "bun drizzle-kit studio --config=drizzle.config.ts",
    "db:migrate": "bun drizzle-kit migrate --config=drizzle.config.ts",
    "db:pull": "bun drizzle-kit pull --config=drizzle.config.ts",
    "db:check": "bun drizzle-kit check --config=drizzle.config.ts",
    "db:up": "bun drizzle-kit up --config=drizzle.config.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^3.0.0",
    "@nuxtjs/i18n": "^9.3.1",
    "@nuxtjs/tailwindcss": "^6.13.2",
    "@tailwindcss/upgrade": "^4.0.14",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.40.1",
    "lucide-vue-next": "^0.483.0",
    "nuxt": "^3.16.0",
    "reka-ui": "^2.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/image": "^1.10.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@tailwindcss/vite": "^4.0.14",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.22.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^10.0.0",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2"
  }
}
